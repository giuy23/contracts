# Configuración de Base de Datos MySQL (WSL / Localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=etl_user
DB_PASSWORD=etl_password
DB_NAME=contrataciones
DB_CHARSET=utf8mb4

# URL completa para SQLAlchemy
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Parámetros del Pipeline
CHUNK_SIZE=3000

