# ========================================================
# CONTRATACIONES SEACE - MONOREPO ENVIRONMENT VARIABLES
# ========================================================
# Copie este archivo como referencia para los subproyectos:
# - contracts_etl/.env
# - frontend/.env

# --- Configuración Compartida de Base de Datos MySQL 8.0 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=etl_user
DB_PASSWORD=etl_password
DB_NAME=contrataciones
DB_CHARSET=utf8mb4

# --- Backend / Frontend (NestJS) ---
PORT=3000
NODE_ENV=development
DB_CONNECTION_LIMIT=10

# --- Pipeline ETL (Python) ---
CHUNK_SIZE=3000
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4
